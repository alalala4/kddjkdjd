# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# Telegram Bot Token (получить у @BotFather в Telegram)
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Google AI API Key (получить на https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Ваш Telegram User ID (узнать: напишите @userinfobot в Telegram)
