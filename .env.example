# Telegram Bot Token (от @BotFather)
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# OpenAI API Key или ключ OpenAI-совместимого провайдера
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# Если ключ от OpenAI-совместимого провайдера, укажите его base URL.
# Например для freemodel.dev: https://api.freemodel.dev/v1
# Для обычного OpenAI оставьте пустым.
OPENAI_BASE_URL=

# Модели можно переопределить под своего провайдера.
CHAT_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1

# Для OpenAI-совместимых провайдеров без Responses API лучше отключить web search.
ENABLE_WEB_SEARCH=1
ENABLE_IMAGE_GENERATION=1

# Ваш Telegram ID (от @userinfobot)
ALLOWED_USER_ID=123456789
